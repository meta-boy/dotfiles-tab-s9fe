#!/bin/sh
# Super+Tab: pick a window by title (i3 had rofi -show window)
pkill -x rofi && exit 0
# Titles are set by apps (a web page can choose its own), so flatten tabs and newlines, and only
# ever hand hyprctl a plain hex window address
choice=$(hyprctl clients -j | jq -r '.[] | select(.mapped) |
             "\(.address)\t[\(.workspace.name)] \(.class): \(.title | gsub("[\t\n\r]"; " "))"' |
         rofi -dmenu -i -p "Windows" -theme ~/.config/rofi/list.rasi -display-columns 2 -display-column-separator "\t" | cut -f1)
case "$choice" in
    0x*[!0-9a-f]* | "") exit 0 ;;
    0x*) hyprctl dispatch "hl.dsp.focus({ window = \"address:$choice\" })" >/dev/null ;;
esac
