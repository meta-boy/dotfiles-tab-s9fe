/* Generated by matugen from the wallpaper (~/.local/bin/wallpaper); edit ~/.config/matugen/templates */
* {
    crust:    {{colors.surface_container_lowest.default.hex}};
    mantle:   {{colors.surface_container_low.default.hex}};
    base:     {{colors.surface.default.hex}};
    base-translucent: {{colors.surface.default.hex}}f0;
    surface0: {{colors.surface_container_high.default.hex}};
    surface1: {{colors.surface_container_highest.default.hex}};
    overlay0: {{colors.outline.default.hex}};
    subtext:  {{colors.on_surface_variant.default.hex}};
    text:     {{colors.on_surface.default.hex}};
    accent:   {{colors.primary.default.hex}};
    accent2:  {{colors.tertiary.default.hex}};
}
