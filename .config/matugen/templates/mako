# Generated by matugen from the wallpaper (~/.local/bin/wallpaper); edit ~/.config/matugen/templates/mako
font=JetBrainsMono Nerd Font 11
anchor=top-right
outer-margin=6,12
margin=6
padding=12,14
width=360
height=160
border-size=2
border-radius=12
icons=1
max-icon-size=40
default-timeout=5000
layer=overlay

background-color={{colors.surface.default.hex}}e6
text-color={{colors.on_surface.default.hex}}
border-color={{colors.primary.default.hex}}
progress-color=over {{colors.surface_container_high.default.hex}}

[urgency=low]
border-color={{colors.outline.default.hex}}

[urgency=high]
border-color={{colors.error.default.hex}}
default-timeout=0
