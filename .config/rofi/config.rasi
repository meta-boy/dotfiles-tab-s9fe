/*
 * Launcher (Super+Space, Super+D): a launchpad-style icon grid sized for touch.
 * list.rasi reuses the palette for list menus (status menu, window switcher). Colours come from
 * colors.rasi, generated by matugen from the wallpaper (~/.local/bin/wallpaper).
 */
configuration {
    modi:                "drun,run";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        "  Apps";
    display-run:         "  Run";
    font:                "JetBrainsMono Nerd Font 11";
    case-sensitive:      false;
    matching:            "fuzzy";
    sort:                true;
    sorting-method:      "fzf";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

@import "colors.rasi"

* {
    background-color: transparent;
    text-color:       @text;
    spacing:          0;
}

window {
    width:            780px;
    location:         center;
    anchor:           center;
    border:           2px;
    border-color:     @accent;
    border-radius:    20px;
    background-color: @base-translucent;
}

mainbox {
    padding:  18px;
    spacing:  16px;
    children: [ inputbar, listview, mode-switcher ];
}

/* Search */
inputbar {
    padding:          12px 16px;
    border-radius:    14px;
    background-color: @surface0;
    text-color:       @text;
    spacing:          12px;
    children:         [ textbox-search, entry, num-filtered-rows ];
}
textbox-search {
    expand:         false;
    str:            "";
    text-color:     @accent;
    vertical-align: 0.5;
}
entry {
    placeholder:       "Search apps";
    placeholder-color: @overlay0;
    text-color:        @text;
    cursor:            text;
    vertical-align:    0.5;
}
num-filtered-rows {
    expand:         false;
    text-color:     @overlay0;
    vertical-align: 0.5;
}

/* Grid: fixed 5 x 3, so nothing resizes while scrolling */
listview {
    columns:      5;
    lines:        3;
    fixed-height: true;
    fixed-columns: true;
    dynamic:      false;
    scrollbar:    false;
    cycle:        false;
    spacing:      8px;
    flow:         horizontal;
}

element {
    orientation:   vertical;
    padding:       14px 6px 10px 6px;
    spacing:       10px;
    border:        1px;
    border-color:  transparent;
    border-radius: 16px;
    cursor:        pointer;
}
element normal.normal,
element alternate.normal { background-color: transparent; }
element selected.normal {
    background-color: @surface0;
    border-color:     @accent;
}
element-icon {
    size:   56px;
    cursor: inherit;
}
element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       @subtext;
    cursor:           inherit;
}
element-text selected { text-color: @text; }

/* Apps / Run tabs */
mode-switcher {
    spacing: 8px;
}
button {
    padding:          8px;
    border-radius:    12px;
    background-color: @mantle;
    text-color:       @overlay0;
    cursor:           pointer;
}
button selected {
    background-color: @surface0;
    text-color:       @accent;
}

/* Empty search, errors */
message {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @mantle;
}
textbox { text-color: @subtext; }
