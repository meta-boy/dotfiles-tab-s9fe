/* Wallpaper picker (Super+Shift+Space): a horizontal strip of thumbnails; scroll or swipe through it */
@import "config.rasi"

configuration { show-icons: true; }
window   { width: 1180px; }
mainbox  { children: [ inputbar, listview ]; }
entry    { placeholder: "Search wallpapers"; }
listview {
    columns:       4;
    lines:         1;
    flow:          horizontal;
    fixed-columns: true;
    spacing:       12px;
}
element {
    orientation: vertical;
    padding:     10px;
    spacing:     8px;
}
element-icon {
    size:          250px;
    border-radius: 10px;
}
element-text {
    horizontal-align: 0.5;
}
