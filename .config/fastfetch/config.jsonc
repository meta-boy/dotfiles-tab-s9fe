{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "color": { "1": "38;2;203;166;247", "2": "38;2;137;180;250" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;203;166;247", "title": "38;2;137;180;250", "separator": "38;2;108;112;134" },
    "percent": { "type": 3 },
    "key": { "type": "string" }
  },
  "modules": [
    { "type": "title", "color": { "user": "38;2;166;227;161", "at": "38;2;108;112;134", "host": "38;2;137;180;250" } },
    { "type": "separator", "string": "─" },
    { "type": "os", "key": "OS" },
    { "type": "custom", "key": "Host", "format": "Samsung Galaxy Tab S9 FE (SM-X510)" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Pkgs" },
    { "type": "custom", "key": "Shell", "format": "zsh", "keyColor": "38;2;203;166;247" },
    { "type": "display", "key": "Display" },
    { "type": "wm", "key": "WM" },
    { "type": "terminal", "key": "Term" },
    { "type": "custom", "key": "CPU", "format": "Exynos 1380 (4+4) @ 2.40 GHz" },
    { "type": "custom", "key": "GPU", "format": "Mali-G68 MP4" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "command", "key": "Disk (/)", "text": "df -h / | awk 'NR==2{printf \"%s / %s (%s)\", $3, $2, $5}'" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
